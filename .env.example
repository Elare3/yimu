# ===== MongoDB =====
DATABASE_URL=mongodb://localhost:27017/yimu_db

# ===== NextAuth =====
NEXTAUTH_SECRET=your-random-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ===== AI引擎（阿里云百炼 DashScope）=====
DASHSCOPE_API_KEY=your-dashscope-api-key
PRIMARY_MODEL=qwen-max
LIGHT_MODEL=deepseek-chat

# ===== 备用：DeepSeek直连 =====
DEEPSEEK_API_KEY=your-deepseek-api-key

# ===== 微信开放平台（网站应用 - 扫码登录）=====
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret
NEXT_PUBLIC_WECHAT_APP_ID=wx_your_app_id
# 微信开放平台申请：https://open.weixin.qq.com
# 回调域名需在开放平台配置，指向 /api/auth/wechat-qr-callback

# ===== 敏感字段加密 (AES-256-GCM) =====
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
